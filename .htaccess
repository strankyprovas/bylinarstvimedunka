# /www/domains/bylinarstvimedunka.cz/.htaccess
RewriteEngine On

# Pojistka: cokoliv z fyzické cesty přesměruj na čistou URL
RewriteCond %{REQUEST_URI} ^/data/web/virtuals/381405/virtual/www/domains/bylinarstvimedunka\.cz/ [NC]
RewriteRule ^data/web/virtuals/381405/virtual/www/domains/bylinarstvimedunka\.cz/(.*)$ /$1 [R=301,L]

# www -> bez www (jen pokud chceš)
RewriteCond %{HTTP_HOST} ^www\.bylinarstvimedunka\.cz$ [NC]
RewriteRule ^ https://bylinarstvimedunka.cz%{REQUEST_URI} [R=301,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# /neco.html -> /neco (kanonická URL)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Hezké URL: interně /neco -> /neco.html (když existuje)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Bezpečnost + zákaz výpisu adresářů
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

DirectoryIndex index.html index.php
